<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>HorticultureNovelSeeds</AssemblyName>
    <RootNamespace>HorticultureNovelSeeds</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <Version>0.1.0-alpha</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.1.0-alpha+unstamped</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants Condition="'$(NativeFixture)' == 'true'">$(DefineConstants);HNS_NATIVE_FIXTURE</DefineConstants>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../DevTools/Staged/Native17/Assemblies/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties/AssemblyInfo.cs;BreedingMixRegression.cs;CrossPollinationRegression.cs;MaskProjectionRegression.cs;TraitCatalogRegression.cs" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5013-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.7" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
