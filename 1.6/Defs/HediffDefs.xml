<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>HNS_PainresinExposure</defName>
    <label>painresin exposure</label>
    <description>Skin contact with irritating plant resin causes temporary pain.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3000~6000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><painOffset>0.12</painOffset></li>
    </stages>
  </HediffDef>
</Defs>